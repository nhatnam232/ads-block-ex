{
  "action": {
    "default_icon": {
      "16": "img/icon_16.png",
      "32": "img/icon_32.png",
      "64": "img/icon_64.png",
      "128": "img/icon_128.png"
    },
    "default_popup": "popup/popup.html",
    "default_title": "__MSG_extName__"
  },
  "author": "nhatnam232 (jades) <kobitnx223@gmail.com>",
  "background": {
    "service_worker": "/js/background.js",
    "type": "module"
  },
  "default_locale": "en",
  "description": "__MSG_extShortDesc__",
  "host_permissions": [
    "<all_urls>"
  ],
  "icons": {
    "16": "img/icon_16.png",
    "32": "img/icon_32.png",
    "64": "img/icon_64.png",
    "128": "img/icon_128.png"
  },
  "manifest_version": 3,
  "minimum_chrome_version": "129.0",
  "name": "__MSG_extName__",
  "optional_permissions": [
    "declarativeNetRequestFeedback"
  ],
  "options_page": "options/options.html",
  "permissions": [
    "activeTab",
    "alarms",
    "declarativeNetRequest",
    "scripting",
    "storage",
    "unlimitedStorage",
    "webNavigation",
    "userScripts"
  ],
  "short_name": "Ethereals",
  "version": "0.1.0",
  "web_accessible_resources": [
    {
      "resources": [
        "/web_accessible_resources/*"
      ],
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "use_dynamic_url": true
    }
  ]
}
